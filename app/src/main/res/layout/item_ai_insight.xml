<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#E8F8F3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/insightBorder"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#00C177"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tvInsightMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Your sleep quality is excellent. Keep maintaining this consistent sleep schedule."
            android:textColor="#4A4A4A"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
