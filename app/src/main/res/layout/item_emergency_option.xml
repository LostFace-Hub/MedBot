<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:padding="14dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/emergency_option_box">

    <ImageView
        android:id="@+id/optionIcon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_ambulance"/>

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/optionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Call Ambulance"
            android:textSize="16sp"
            android:textColor="#D60000"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/optionSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto-dial Emergency Services"
            android:textSize="13sp"
            android:textColor="#4A4A4A"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

</LinearLayout>
