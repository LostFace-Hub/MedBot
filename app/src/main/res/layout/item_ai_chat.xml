<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="start">

    <!-- AI Icon -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="#E0F7FA"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_ai_chat"
            app:tint="#1BA3C4" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Message Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- MedoAI Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MedoAI"
            android:textColor="#1BA3C4"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- Message Bubble -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            app:cardBackgroundColor="#F5F7FA"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Message Text -->
                <TextView
                    android:id="@+id/tvAiMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Based on your symptoms, here are a few possibilities:\n\n• Common Cold 🤧\n• Seasonal Flu 🦠\n• Viral Infection 🔬\n• It's advisable to get evaluated 📋\n• Get plenty of rest 😴\n• Consider a warm salt water gargle for throat relief 🧂\n• Monitor your temperature regularly 🌡️\n\n⚠️ If symptoms worsen, please consult a doctor immediately."
                    android:textColor="#1F2937"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
